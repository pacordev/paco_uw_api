# Local dev: points at the docker-compose Postgres from the `underwritting` repo
# (defaults there: user uw_admin, db underwriting, port 5432).
DATABASE_URL=postgresql://uw_admin:uw_dev_password@localhost:5432/underwriting

# Required - the app refuses to start CORS with a wildcard, so this must be set explicitly
# per environment. Comma-separated if more than one origin (e.g. prod + a Vercel preview URL).
ALLOWED_ORIGINS=http://localhost:3000

# Optional - defaults to enabled (true). Set to "false" to disable slowapi rate limiting,
# e.g. while manually hammering the API for other testing. The pytest suite sets this itself
# (see tests/conftest.py); you shouldn't normally need to set it here.
# RATE_LIMIT_ENABLED=true

# Optional - defaults to enabled (true), so /docs, /redoc and /openapi.json all work out of
# the box locally. render.yaml sets this to "false" for the deployed service.
# EXPOSE_API_DOCS=true

# Required - shared secret for the admin endpoints (app/admin.py: create products,
# questions, rules), sent as X-Admin-Key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_API_KEY=change-me

# Optional - defaults to 100000 (100 KB), generous for a 5-8 question answer batch. Caps
# request body size at the ASGI level (app/body_limit.py) - a public unauthenticated POST
# endpoint shouldn't accept an arbitrarily large payload.
# MAX_REQUEST_BODY_BYTES=100000
